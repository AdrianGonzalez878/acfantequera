# Copia este archivo como .env.local y complétalo.

# --- Sitio -------------------------------------------------------------------
# Dominio final. Se usa en metadatos, sitemap y JSON-LD.
NEXT_PUBLIC_SITE_URL=https://acfantequera.mx

# --- Sanity (videos y podcast) ----------------------------------------------
# El Project ID es público (va en el cliente). El secreto del webhook no.
NEXT_PUBLIC_SANITY_PROJECT_ID=9pvs64su
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01

# Secreto del webhook de Sanity (sanity.io/manage → API → Webhooks).
# Permite que el sitio se actualice al instante al publicar contenido.
SANITY_REVALIDATE_SECRET=
